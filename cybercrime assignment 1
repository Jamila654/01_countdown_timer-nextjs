        "import re\n",
        "import math\n",
        "import string\n",
        "import secrets\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# DATA: the suspicious passwords from the challenge\n",
        "# ----------------------------------------------------------\n",
        "PASSWORDS = [\n",
        "    \"Pakistan123\",\n",
        "    \"Admin@123\",\n",
        "    \"Cyber@2026\",\n",
        "    \"P@ssw0rd\",\n",
        "    \"IqraUniversity123\",\n",
        "    \"qwerty123\",\n",
        "    \"C0ffee@123\",\n",
        "    \"N3twork#2026\",\n",
        "]\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# KNOWLEDGE BASE (used for the bonus pattern detection)\n",
        "# ----------------------------------------------------------\n",
        "COMMON_WORDS = [\"password\", \"passwd\", \"admin\", \"root\", \"login\", \"welcome\",\n",
        "                \"letmein\", \"cyber\", \"network\", \"coffee\", \"secret\", \"master\",\n",
        "                \"hacker\", \"security\", \"user\"]\n",
        "PLACE_AND_UNI_NAMES = [\"pakistan\", \"karachi\", \"lahore\", \"islamabad\",\n",
        "                       \"iqra\", \"university\", \"uni\", \"college\"]\n",
        "KEYBOARD_PATTERNS = [\"qwerty\", \"qwert\", \"asdf\", \"asdfgh\", \"zxcv\", \"qazwsx\",\n",
        "                     \"1qaz\", \"poiuy\", \"lkjhg\"]\n",
        "\n",
        "# Leetspeak -> normal letters (to catch P@ssw0rd, C0ffee, N3twork ...)\n",
        "LEET_MAP = str.maketrans({\"@\": \"a\", \"0\": \"o\", \"3\": \"e\", \"1\": \"i\",\n",
        "                          \"$\": \"s\", \"5\": \"s\", \"7\": \"t\", \"!\": \"i\", \"4\": \"a\"})\n",
        "\n",
        "SYMBOLS = \"!@#$%^&*()-_=+?\"\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# DETECTION HELPERS\n",
        "# ----------------------------------------------------------\n",
        "def has_sequence(pw, min_len=3):\n",
        "    \"\"\"Detects ascending/descending runs like 123, 321, abc, cba.\"\"\"\n",
        "    p = pw.lower()\n",
        "    for i in range(len(p) - min_len + 1):\n",
        "        chunk = p[i:i + min_len]\n",
        "        if not chunk.isalnum():\n",
        "            continue\n",
        "        diffs = [ord(chunk[j + 1]) - ord(chunk[j]) for j in range(len(chunk) - 1)]\n",
        "        if all(d == 1 for d in diffs) or all(d == -1 for d in diffs):\n",
        "            return chunk\n",
        "    return None\n",
        "\n",
        "\n",
        "def find_words(text, wordlist):\n",
        "    return [w for w in wordlist if w in text]\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASKS 1-3 and BONUS: analyze password, detect weaknesses, score it\n",
        "# ----------------------------------------------------------\n",
        "def analyze(pw):\n",
        "    weaknesses = []  # list of (name, penalty, explanation)\n",
        "    lower = pw.lower()\n",
        "    normalized = lower.translate(LEET_MAP)\n",
        "\n",
        "    # --- Character classes ---\n",
        "    has_lower = any(c.islower() for c in pw)\n",
        "    has_upper = any(c.isupper() for c in pw)\n",
        "    has_digit = any(c.isdigit() for c in pw)\n",
        "    has_symbol = any(c in string.punctuation for c in pw)\n",
        "\n",
        "    # --- Weakness 1: length ---\n",
        "    if len(pw) < 8:\n",
        "        weaknesses.append((\"Too short\", 15, f\"only {len(pw)} characters (minimum 12 recommended)\"))\n",
        "    elif len(pw) < 12:\n",
        "        weaknesses.append((\"Short length\", 8, f\"{len(pw)} characters; 12+ is recommended\"))\n",
        "\n",
        "    # --- Weakness 2: missing character types ---\n",
        "    for present, label in [(has_lower, \"lowercase letters\"), (has_upper, \"uppercase letters\"),\n",
        "                           (has_digit, \"digits\"), (has_symbol, \"special symbols\")]:\n",
        "        if not present:\n",
        "            weaknesses.append((\"Missing \" + label, 5, f\"no {label} used\"))\n",
        "\n",
        "    # --- Weakness 3: common dictionary words (also found through leetspeak) ---\n",
        "    common_hits = find_words(normalized, COMMON_WORDS)\n",
        "    if common_hits:\n",
        "        weaknesses.append((\"Common word\", 20, f\"contains common word(s): {', '.join(common_hits)}\"))\n",
        "\n",
        "    # --- Weakness 4: place / university names (bonus) ---\n",
        "    name_hits = find_words(normalized, PLACE_AND_UNI_NAMES)\n",
        "    if name_hits:\n",
        "        weaknesses.append((\"Personal/institution name\", 15,\n",
        "                           f\"contains guessable name(s): {', '.join(name_hits)}\"))\n",
        "\n",
        "    # --- Weakness 5: leetspeak substitutions ---\n",
        "    leet_only = [w for w in COMMON_WORDS + PLACE_AND_UNI_NAMES\n",
        "                 if w in normalized and w not in lower]\n",
        "    if leet_only:\n",
        "        weaknesses.append((\"Predictable leetspeak\", 10,\n",
        "                           f\"'{', '.join(leet_only)}' hidden with substitutions (@->a, 0->o, 3->e); \"\n",
        "                           \"attackers try these first\"))\n",
        "\n",
        "    # --- Weakness 6: sequences like 123 / abc ---\n",
        "    seq = has_sequence(pw)\n",
        "    if seq:\n",
        "        weaknesses.append((\"Sequential pattern\", 15, f\"contains sequence '{seq}'\"))\n",
        "\n",
        "    # --- Weakness 7: keyboard patterns like qwerty ---\n",
        "    kb = find_words(lower, KEYBOARD_PATTERNS)\n",
        "    if kb:\n",
        "        weaknesses.append((\"Keyboard pattern\", 15, f\"contains keyboard walk '{kb[0]}'\"))\n",
        "\n",
        "    # --- Weakness 8: years ---\n",
        "    year = re.search(r\"(?<!\\d)(19|20)\\d{2}(?!\\d)\", pw)\n",
        "    if year:\n",
        "        weaknesses.append((\"Contains a year\", 10, f\"contains year '{year.group()}'\"))\n",
        "\n",
        "    # --- Weakness 9: repeated characters ---\n",
        "    rep = re.search(r\"(.)\\1{2,}\", pw)\n",
        "    if rep:\n",
        "        weaknesses.append((\"Repeated characters\", 10, f\"'{rep.group()}' repeats\"))\n",
        "\n",
        "    # --- Weakness 10: Word + digits/symbols suffix (e.g. Admin@123) ---\n",
        "    if re.fullmatch(r\"[A-Za-z]+[^A-Za-z]{1,6}\", pw) or re.fullmatch(r\"[A-Za-z0-9]*[A-Za-z][@#$!_-]?\\d{2,4}\", pw):\n",
        "        weaknesses.append((\"Predictable structure\", 8,\n",
        "                           \"follows the common 'Word + symbol + numbers' format\"))\n",
        "\n",
        "    # --------------- SCORE (0-100) ---------------\n",
        "    pool = 26 * has_lower + 26 * has_upper + 10 * has_digit + 32 * has_symbol\n",
        "    entropy = len(pw) * math.log2(pool) if pool else 0\n",
        "\n",
        "    length_pts = min(len(pw), 16) / 16 * 30           # up to 30\n",
        "    variety_pts = 5 * sum([has_lower, has_upper, has_digit, has_symbol])  # up to 20\n",
        "    unique_pts = (len(set(pw)) / len(pw)) * 10 if pw else 0               # up to 10\n",
        "    entropy_pts = min(entropy / 80, 1) * 20                               # up to 20\n",
        "\n",
        "    score = length_pts + variety_pts + unique_pts + entropy_pts\n",
        "    score -= sum(p for _, p, _ in weaknesses)\n",
        "    if not weaknesses:\n",
        "        score += 20                                    # bonus for a clean password\n",
        "    score = max(0, min(100, round(score)))\n",
        "\n",
        "    if score < 30:\n",
        "        label = \"VERY WEAK\"\n",
        "    elif score < 50:\n",
        "        label = \"WEAK\"\n",
        "    elif score < 70:\n",
        "        label = \"MODERATE\"\n",
        "    elif score < 85:\n",
        "        label = \"STRONG\"\n",
        "    else:\n",
        "        label = \"VERY STRONG\"\n",
        "\n",
        "    return {\"password\": pw, \"score\": score, \"label\": label,\n",
        "            \"weaknesses\": weaknesses, \"entropy\": round(entropy, 1)}\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 4: generate a stronger replacement password\n",
        "# ----------------------------------------------------------\n",
        "def generate_strong_password(length=16):\n",
        "    rng = secrets.SystemRandom()\n",
        "    while True:\n",
        "        chars = [secrets.choice(string.ascii_lowercase),\n",
        "                 secrets.choice(string.ascii_uppercase),\n",
        "                 secrets.choice(string.digits),\n",
        "                 secrets.choice(SYMBOLS)]\n",
        "        allowed = string.ascii_letters + string.digits + SYMBOLS\n",
        "        chars += [secrets.choice(allowed) for _ in range(length - 4)]\n",
        "        rng.shuffle(chars)\n",
        "        candidate = \"\".join(chars)\n",
        "        result = analyze(candidate)\n",
        "        # accept only if it passes our own checker cleanly\n",
        "        if not result[\"weaknesses\"] and result[\"score\"] >= 85:\n",
        "            return candidate\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 5: explain the verdict\n",
        "# ----------------------------------------------------------\n",
        "def explain(result):\n",
        "    if not result[\"weaknesses\"]:\n",
        "        return (\"Considered strong: it is long, mixes all character types, has high \"\n",
        "                \"randomness, and contains no dictionary words, sequences, or years.\")\n",
        "    reasons = \"; \".join(f\"{name} ({why})\" for name, _, why in result[\"weaknesses\"])\n",
        "    return f\"Considered {result['label'].lower()} because: {reasons}.\"\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# MAIN REPORT\n",
        "# ----------------------------------------------------------\n",
        "def bar(score, width=25):\n",
        "    filled = round(score / 100 * width)\n",
        "    return \"[\" + \"#\" * filled + \"-\" * (width - filled) + \"]\"\n",
        "\n",
        "\n",
        "def main():\n",
        "    print(\"=\" * 78)\n",
        "    print(\"PASSWORD POLICE - Password Strength Report\")\n",
        "    print(\"=\" * 78)\n",
        "\n",
        "    summary = []\n",
        "    for pw in PASSWORDS:\n",
        "        r = analyze(pw)\n",
        "        new_pw = generate_strong_password()\n",
        "        new_r = analyze(new_pw)\n",
        "        summary.append((pw, r[\"score\"], r[\"label\"], new_pw, new_r[\"score\"]))\n",
        "\n",
        "        print(f\"\\nPassword      : {pw}\")\n",
        "        print(f\"Score         : {r['score']}/100 {bar(r['score'])}  -> {r['label']}\")\n",
        "        print(f\"Est. entropy  : {r['entropy']} bits\")\n",
        "        print(f\"Weaknesses ({len(r['weaknesses'])}):\")\n",
        "        if r[\"weaknesses\"]:\n",
        "            for name, penalty, why in r[\"weaknesses\"]:\n",
        "                print(f\"   - {name}: {why}  (-{penalty})\")\n",
        "        else:\n",
        "            print(\"   - none detected\")\n",
        "        print(f\"Replacement   : {new_pw}   (score {new_r['score']}/100)\")\n",
        "        print(f\"Explanation   : {explain(r)}\")\n",
        "        print(\"-\" * 78)\n",
        "\n",
        "    # Summary table\n",
        "    print(\"\\nSUMMARY\")\n",
        "    print(f\"{'Original':<20}{'Score':<8}{'Rating':<13}{'Replacement':<20}{'New score'}\")\n",
        "    for pw, s, lab, npw, ns in summary:\n",
        "        print(f\"{pw:<20}{s:<8}{lab:<13}{npw:<20}{ns}\")\n",
        "\n",
        "\n",
        "main()\n",
        "\n",
        "# Optional: test your own password\n",
        "# print(explain(analyze(\"YourPasswordHere\")))"
