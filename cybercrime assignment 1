        "          \"instagram\", \"netflix\", \"whatsapp\"]\n",
        "BAD_TLDS = {\".xyz\", \".top\", \".tk\", \".ml\", \".ga\", \".cf\", \".gq\", \".click\", \".zip\", \".work\"}\n",
        "TWO_LEVEL_SUFFIXES = {\"co.uk\", \"ac.uk\", \"com.pk\", \"edu.pk\", \"gov.pk\", \"org.pk\",\n",
        "                      \"net.pk\", \"com.au\", \"co.in\"}\n",
        "\n",
        "TEST_URLS = [\n",
        "    \"https://google.com\",\n",
        "    \"http://192.168.1.10/login\",\n",
        "    \"https://secure-login-example.com\",\n",
        "    \"http://paypal-login-free-security.com\",\n",
        "    \"https://university.edu/student\",\n",
        "]\n",
        "EXTRA_TESTS = [   # extra cases to show the other checks working\n",
        "    \"http://login.secure.verify.account.bank-update.xyz/confirm?id=1\",\n",
        "    \"https://example.com/\" + \"a\" * 130,\n",
        "]\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# HELPERS\n",
        "# ----------------------------------------------------------\n",
        "def is_ip(host):\n",
        "    try:\n",
        "        ipaddress.ip_address(host)\n",
        "        return True\n",
        "    except ValueError:\n",
        "        return False\n",
        "\n",
        "\n",
        "def split_host(host):\n",
        "    \"\"\"Return (subdomain_labels, registered_label, suffix).\"\"\"\n",
        "    labels = host.split(\".\")\n",
        "    n = 2 if \".\".join(labels[-2:]) in TWO_LEVEL_SUFFIXES else 1\n",
        "    suffix = \".\".join(labels[-n:])\n",
        "    if len(labels) <= n:\n",
        "        return [], labels[0], suffix\n",
        "    return labels[:-n - 1], labels[-n - 1], suffix\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# THE CHECKS (each returns points + reason text)\n",
        "# ----------------------------------------------------------\n",
        "def check_protocol(parsed):\n",
        "    if parsed.scheme == \"http\":\n",
        "        return WEIGHTS[\"http\"], \"Uses HTTP (not encrypted)\"\n",
        "    return 0, None\n",
        "\n",
        "\n",
        "def check_ip(host):\n",
        "    if is_ip(host):\n",
        "        return WEIGHTS[\"ip_address\"], \"Uses IP address instead of a domain name\"\n",
        "    return 0, None\n",
        "\n",
        "\n",
        "def check_keywords(host, path_query):\n",
        "    text = (host + path_query).lower()\n",
        "    found = [k for k in SUSPICIOUS_KEYWORDS if k in text]\n",
        "    if not found:\n",
        "        return 0, None\n",
        "    pts = min(WEIGHTS[\"keyword_first\"] + WEIGHTS[\"keyword_extra\"] * (len(found) - 1),\n",
        "              WEIGHTS[\"keyword_max\"])\n",
        "    msg = \"Login page detected\" if \"login\" in found else \"Suspicious keywords\"\n",
        "    if len(found) > 1 or \"login\" not in found:\n",
        "        others = [k for k in found if not (msg == \"Login page detected\" and k == \"login\")]\n",
        "        msg += f\" ({', '.join(others)})\" if msg == \"Login page detected\" else f\": {', '.join(found)}\"\n",
        "    return pts, msg\n",
        "\n",
        "\n",
        "def check_subdomains(host):\n",
        "    if is_ip(host):\n",
        "        return 0, None\n",
        "    subs, _, _ = split_host(host)\n",
        "    subs = [s for s in subs if s != \"www\"]\n",
        "    if len(subs) >= 3:\n",
        "        return WEIGHTS[\"subdomains_3plus\"], f\"Excessive subdomains ({len(subs)}: {'.'.join(subs)})\"\n",
        "    if len(subs) == 2:\n",
        "        return WEIGHTS[\"subdomains_2\"], f\"Many subdomains ({len(subs)}: {'.'.join(subs)})\"\n",
        "    return 0, None\n",
        "\n",
        "\n",
        "def check_domain_structure(host, full_url):\n",
        "    \"\"\"Several structural red flags, combined and capped.\"\"\"\n",
        "    pts, reasons = 0, []\n",
        "    if is_ip(host):\n",
        "        return 0, []\n",
        "    _, reg, suffix = split_host(host)\n",
        "    hyphens = reg.count(\"-\")\n",
        "    if hyphens >= 3:\n",
        "        pts += WEIGHTS[\"hyphens_3plus\"]\n",
        "        reasons.append(f\"Suspicious domain structure: {hyphens} hyphens in domain name\")\n",
        "    elif hyphens == 2:\n",
        "        pts += WEIGHTS[\"hyphens_2\"]\n",
        "        reasons.append(\"Suspicious domain structure: 2 hyphens in domain name\")\n",
        "\n",
        "    for brand in BRANDS:\n",
        "        if brand in host and reg != brand:\n",
        "            pts += WEIGHTS[\"brand_impersonation\"]\n",
        "            reasons.append(f\"Brand impersonation: '{brand}' appears in a domain that is not {brand}.com\")\n",
        "            break\n",
        "\n",
        "    if \".\" + suffix.split(\".\")[-1] in BAD_TLDS:\n",
        "        pts += WEIGHTS[\"bad_tld\"]\n",
        "        reasons.append(f\"Risky top-level domain (.{suffix.split('.')[-1]})\")\n",
        "    if sum(c.isdigit() for c in reg) >= 3:\n",
        "        pts += WEIGHTS[\"digits_in_domain\"]\n",
        "        reasons.append(\"Many digits in domain name\")\n",
        "    if \"xn--\" in host:\n",
        "        pts += WEIGHTS[\"punycode\"]\n",
        "        reasons.append(\"Punycode domain (possible look-alike characters)\")\n",
        "    if \"@\" in full_url:\n",
        "        pts += WEIGHTS[\"at_symbol\"]\n",
        "        reasons.append(\"Contains '@' symbol (can hide the real destination)\")\n",
        "    return min(pts, WEIGHTS[\"domain_structure_max\"]), reasons\n",
        "\n",
        "\n",
        "def check_length(url):\n",
        "    if len(url) > 120:\n",
        "        return WEIGHTS[\"long_url_120\"], f\"Very long URL ({len(url)} characters)\"\n",
        "    if len(url) > 75:\n",
        "        return WEIGHTS[\"long_url_75\"], f\"Long URL ({len(url)} characters)\"\n",
        "    return 0, None\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# MAIN ANALYSIS\n",
        "# ----------------------------------------------------------\n",
        "def analyze(url):\n",
        "    url = url.strip()\n",
        "    work = url if \"://\" in url else \"http://\" + url\n",
        "    parsed = urlparse(work)\n",
        "    host = (parsed.hostname or \"\").lower()\n",
        "    path_query = parsed.path + (\"?\" + parsed.query if parsed.query else \"\")\n",
        "\n",
        "    score, reasons = 0, []\n",
        "\n",
        "    for pts, msg in [check_protocol(parsed), check_ip(host),\n",
        "                     check_keywords(host, path_query), check_subdomains(host),\n",
        "                     check_length(url)]:\n",
        "        if pts:\n",
        "            score += pts\n",
        "            reasons.append(msg)\n",
        "\n",
        "    pts, msgs = check_domain_structure(host, url)\n",
        "    score += pts\n",
        "    reasons += msgs\n",
        "\n",
        "    score = min(score, 100)\n",
        "    level = \"HIGH\" if score >= HIGH_AT else \"MEDIUM\" if score >= MEDIUM_AT else \"LOW\"\n",
        "    return {\"url\": url, \"score\": score, \"level\": level, \"reasons\": reasons}\n",
        "\n",
        "\n",
        "def report(r):\n",
        "    print(f\"URL: {r['url'][:90]}{'...' if len(r['url']) > 90 else ''}\\n\")\n",
        "    print(f\"Risk Score: {r['score']}/100\")\n",
        "    print(f\"Risk Level: {r['level']}\\n\")\n",
        "    print(\"Reasons:\")\n",
        "    if r[\"reasons\"]:\n",
        "        for reason in r[\"reasons\"]:\n",
        "            print(f\"[!] {reason}\")\n",
        "    else:\n",
        "        print(\"[+] No suspicious indicators found\")\n",
        "    print(\"\\n\" + \"-\" * 60 + \"\\n\")\n",
        "\n",
        "\n",
        "def main():\n",
        "    print(\"=\" * 60)\n",
        "    print(\"PHISHING DETECTOR\")\n",
        "    print(\"=\" * 60 + \"\\n\")\n",
        "\n",
        "    results = []\n",
        "    for u in TEST_URLS + EXTRA_TESTS:\n",
        "        r = analyze(u)\n",
        "        results.append(r)\n",
        "        report(r)\n",
        "\n",
        "    print(\"SUMMARY\")\n",
        "    print(f\"{'URL':<48}{'Score':<8}Level\")\n",
        "    for r in results:\n",
        "        short = r[\"url\"] if len(r[\"url\"]) <= 45 else r[\"url\"][:42] + \"...\"\n",
        "        print(f\"{short:<48}{r['score']:<8}{r['level']}\")\n",
        "\n",
        "    print(\"\\nTry your own URL (press Enter on an empty line to quit)\")\n",
        "    while True:\n",
        "        u = input(\"\\nEnter URL: \").strip()\n",
        "        if not u:\n",
        "            print(\"Goodbye!\")\n",
        "            break\n",
        "        print()\n",
        "        report(analyze(u))\n",
        "\n",
        "\n",
        "main()"
      ],
