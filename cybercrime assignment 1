        "    if f[\"reuse\"]:\n",
        "        times = \", \".join(e[\"time_str\"] for e in f[\"reuse\"])\n",
        "        lines.append(f\"Repeat access   : {times} (attacker returned)\")\n",
        "    lines.append(f\"Status          : Account compromise {status}\")\n",
        "    lines.append(\"Why suspicious  :\")\n",
        "    for r in ip_info[f[\"ip\"]][\"reasons\"]:\n",
        "        lines.append(f\"   - {r}\")\n",
