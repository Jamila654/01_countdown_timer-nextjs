        "\"\"\"\n",
        "\n",
        "# a messy real-world log: blank line, garbage line, lowercase / uppercase variations\n",
        "LOG_MESSY = \"\"\"\n",
        "11:00:01 bob 10.0.0.5 FAILED\n",
        "\n",
        "11:00:03 bob 10.0.0.5 failed\n",
        "11:00:05 BOB 10.0.0.5 FAILED\n",
