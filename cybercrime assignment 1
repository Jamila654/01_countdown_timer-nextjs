        "11:00:07 bob 10.0.0.5 SUCCESS\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# STEP 1: THE AI'S ALGORITHM (typical ChatGPT answer to the prompt)\n",
        "# ==========================================================\n",
        "def ai_detect(log_text, threshold=3):\n",
        "    failed = defaultdict(int)\n",
        "    for line in log_text.strip().split(\"\\n\"):\n",
        "        parts = line.split()\n",
        "        timestamp, user, ip, status = parts[0], parts[1], parts[2], parts[3]\n",
        "        if status == \"FAILED\":\n",
        "            failed[ip] += 1\n",
        "    alerts = []\n",
        "    for ip, count in failed.items():\n",
        "        if count >= threshold:\n",
        "            alerts.append({\"type\": \"BRUTE_FORCE\", \"user\": None, \"ips\": [ip],\n",
        "                           \"failures\": count, \"compromised\": None})\n",
        "    return alerts\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# STEP 4: IMPROVED ALGORITHM\n",
        "# ==========================================================\n",
        "LINE_RE = re.compile(\n",
        "    r\"^(?:(\\d{4}-\\d{2}-\\d{2})\\s+)?(\\d{2}:\\d{2}:\\d{2})\\s+(\\S+)\\s+\"\n",
        "    r\"(\\d{1,3}(?:\\.\\d{1,3}){3})\\s+(SUCCESS|FAILED)$\", re.IGNORECASE)\n",
        "\n",
        "BURST_FAILS, BURST_WINDOW = 3, 60        # 3 failures in 60 s from one IP+user\n",
        "DIST_FAILS, DIST_IPS, DIST_WINDOW = 5, 3, 120   # 5 failures from 3+ IPs in 120 s\n",
        "SUCCESS_WITHIN = 300                      # login this soon after a distributed burst = suspicious\n",
        "\n",
        "\n",
        "def parse_robust(text):\n",
        "    events, bad = [], []\n",
        "    for line in text.strip().splitlines():\n",
        "        line = line.strip()\n",
        "        if not line:\n",
        "            continue                      # blank lines are harmless\n",
        "        m = LINE_RE.match(line)\n",
        "        if not m:\n",
        "            bad.append(line)\n",
        "            continue\n",
        "        date, t, user, ip, status = m.groups()\n",
        "        try:\n",
        "            ipaddress.ip_address(ip)\n",
        "            ts = datetime.strptime(f\"{date or '1900-01-01'} {t}\", \"%Y-%m-%d %H:%M:%S\")\n",
        "        except ValueError:\n",
        "            bad.append(line)\n",
        "            continue\n",
        "        events.append({\"ts\": ts, \"t\": t, \"user\": user.lower(), \"ip\": ip,\n",
        "                       \"status\": status.upper()})\n",
        "    return sorted(events, key=lambda e: e[\"ts\"]), bad\n",
        "\n",
        "\n",
        "def best_window(fails, seconds, key=None):\n",
        "    \"\"\"Densest group of failures that fit inside `seconds` (sliding window).\"\"\"\n",
        "    def score(w):\n",
        "        return (len({e[\"ip\"] for e in w}), len(w)) if key == \"ips\" else (len(w),)\n",
        "    best, j = [], 0\n",
        "    for i in range(len(fails)):\n",
        "        while (fails[i][\"ts\"] - fails[j][\"ts\"]).total_seconds() > seconds:\n",
        "            j += 1\n",
        "        window = fails[j:i + 1]\n",
        "        if not best or score(window) > score(best):\n",
        "            best = window\n",
        "    return best\n",
        "\n",
        "\n",
        "def improved_detect(log_text):\n",
        "    events, bad = parse_robust(log_text)\n",
        "    alerts = []\n",
        "\n",
        "    # rule A: burst from one IP against one account (time-windowed, per user+IP)\n",
        "    pairs = defaultdict(list)\n",
        "    for e in events:\n",
        "        pairs[(e[\"ip\"], e[\"user\"])].append(e)\n",
        "    for (ip, user), evs in pairs.items():\n",
        "        fails = [e for e in evs if e[\"status\"] == \"FAILED\"]\n",
        "        win = best_window(fails, BURST_WINDOW)\n",
        "        if len(win) >= BURST_FAILS:\n",
        "            later = [e for e in evs if e[\"status\"] == \"SUCCESS\" and e[\"ts\"] > win[-1][\"ts\"]]\n",
        "            alerts.append({\"type\": \"BRUTE_FORCE\", \"user\": user, \"ips\": [ip],\n",
        "                           \"failures\": len(win), \"first\": win[0][\"t\"], \"last\": win[-1][\"t\"],\n",
        "                           \"compromised\": bool(later),\n",
        "                           \"success_times\": [e[\"t\"] for e in later]})\n",
        "\n",
        "    # rule B: distributed attack on one account from many IPs\n",
        "    by_user = defaultdict(list)\n",
        "    for e in events:\n",
        "        by_user[e[\"user\"]].append(e)\n",
        "    for user, evs in by_user.items():\n",
        "        fails = [e for e in evs if e[\"status\"] == \"FAILED\"]\n",
        "        win = best_window(fails, DIST_WINDOW, key=\"ips\")\n",
        "        ips = sorted({e[\"ip\"] for e in win})\n",
        "        if len(win) >= DIST_FAILS and len(ips) >= DIST_IPS:\n",
        "            later = [e for e in evs if e[\"status\"] == \"SUCCESS\" and e[\"ts\"] > win[-1][\"ts\"]\n",
        "                     and (e[\"ts\"] - win[-1][\"ts\"]).total_seconds() <= SUCCESS_WITHIN]\n",
        "            alerts.append({\"type\": \"DISTRIBUTED\", \"user\": user, \"ips\": ips,\n",
        "                           \"failures\": len(win), \"first\": win[0][\"t\"], \"last\": win[-1][\"t\"],\n",
        "                           \"compromised\": bool(later),\n",
        "                           \"success_times\": [e[\"t\"] for e in later]})\n",
        "    return alerts, bad\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# TEST HARNESS\n",
        "# ==========================================================\n",
        "TESTS = [\n",
        "    (\"Challenge 2 log (real attack, then login success)\", LOG_CHALLENGE2,\n",
        "     \"alert on 185.44.21.90 AND admin marked COMPROMISED\",\n",
        "     lambda a: any(\"185.44.21.90\" in x[\"ips\"] for x in a)\n",
        "               and any(x[\"user\"] == \"admin\" and x[\"compromised\"] is True for x in a)),\n",
        "    (\"Slow typos by a normal user (no attack)\", LOG_SLOW_TYPOS,\n",
        "     \"NO alerts (3 typos spread over a workday)\",\n",
        "     lambda a: len(a) == 0),\n",
        "    (\"Distributed attack (6 IPs x 2 guesses)\", LOG_DISTRIBUTED,\n",
        "     \"alert on account 'admin'\",\n",
        "     lambda a: any(x[\"user\"] == \"admin\" for x in a)),\n",
        "    (\"Messy log (blank line, garbage, mixed case)\", LOG_MESSY,\n",
        "     \"no crash; brute force on 'bob' detected\",\n",
        "     lambda a: any(x[\"user\"] == \"bob\" for x in a)),\n",
        "]\n",
        "\n",
        "\n",
        "def describe(alert):\n",
        "    who = alert[\"user\"] or \"(unknown account)\"\n",
        "    s = f\"{alert['type']}: {who} from {', '.join(alert['ips'])} - {alert['failures']} failures\"\n",
        "    if alert[\"compromised\"] is True:\n",
        "        s += f\" -> COMPROMISED (login at {', '.join(alert['success_times'])})\"\n",
        "    elif alert[\"compromised\"] is None:\n",
        "        s += \" -> (does not say whether the attack succeeded)\"\n",
        "    return s\n",
        "\n",
        "\n",
        "def run(detector, improved):\n",
        "    results = []\n",
        "    for name, log, expected, check in TESTS:\n",
        "        try:\n",
        "            out = detector(log)\n",
        "            alerts = out[0] if improved else out\n",
        "            err = None\n",
        "        except Exception as ex:\n",
        "            alerts, err = [], f\"{type(ex).__name__}: {ex}\"\n",
        "        ok = err is None and check(alerts)\n",
        "        results.append((name, expected, alerts, err, ok))\n",
        "    return results\n",
        "\n",
        "\n",
        "def show(results):\n",
        "    for i, (name, expected, alerts, err, ok) in enumerate(results, 1):\n",
        "        print(f\"\\nTest {i}: {name}\")\n",
        "        print(f\"  Expected : {expected}\")\n",
        "        if err:\n",
        "            print(f\"  Result   : CRASHED -> {err}\")\n",
        "        elif not alerts:\n",
        "            print(\"  Result   : no alerts\")\n",
        "        else:\n",
        "            for a in alerts:\n",
        "                print(f\"  Result   : {describe(a)}\")\n",
        "        print(f\"  Verdict  : {'PASS' if ok else 'FAIL'}\")\n",
        "\n",
        "\n",
        "def main():\n",
        "    print(\"=\" * 72)\n",
        "    print(\"STEP 1-2: AI ALGORITHM  ->  TEST\")\n",
        "    print(\"=\" * 72)\n",
        "    v1 = run(ai_detect, improved=False)\n",
        "    show(v1)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 72)\n",
        "    print(\"STEP 3: FAILURES FOUND IN THE AI ALGORITHM\")\n",
        "    print(\"=\" * 72)\n",
        "    reasons = {\n",
        "        0: \"It only counts failures per IP. It never checks whether the attacker\\n\"\n",
        "           \"     LOGGED IN afterwards, so it misses the compromised 'admin' account.\",\n",
