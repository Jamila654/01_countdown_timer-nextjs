        "        print(f\"  {f['ip']} -> '{f['user']}': {f['fail_count']} failures within \"\n",
        "              f\"{WINDOW_SECONDS}s ({f['first_fail']}-{f['last_fail']})\")\n",
        "\n",
        "    print(\"\\n[Task 4] Likely compromised account\")\n",
        "    if compromised:\n",
        "        print(f\"  '{compromised['user']}' from {compromised['ip']}  -> {status}\")\n",
        "    else:\n",
        "        print(\"  none\")\n",
        "\n",
        "    print(\"\\n[Task 5] Alert\\n\")\n",
        "    print(build_alert(compromised, status, ips))\n",
        "\n",
        "\n",
        "main()"
