        "import string\n",
        "from collections import Counter\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# DATA\n",
        "# ----------------------------------------------------------\n",
        "CIPHERTEXT = \"VHFUHW SDVVZRUG LV FRIIHH\"\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 1: identify the technique (explained + verified by the code below)\n",
        "# ----------------------------------------------------------\n",
        "# Only letters and spaces, word lengths preserved, letters shifted uniformly\n",
        "# -> a monoalphabetic substitution; specifically a CAESAR CIPHER.\n",
        "# Clue: \"LV\" is a 2-letter word and \"FRIIHH\" has a double-letter ending (EE/HH),\n",
        "# so the shift keeps the structure of English. Shift of 3 is the classic choice.\n",
        "\n",
        "ALPHABET = string.ascii_uppercase\n",
        "\n",
        "# Common English words (plus a few security words) used to recognise real plaintext\n",
        "COMMON_WORDS = {\n",
        "    \"THE\", \"IS\", \"ARE\", \"WAS\", \"AND\", \"OF\", \"TO\", \"IN\", \"IT\", \"YOU\", \"THAT\", \"FOR\",\n",
        "    \"ON\", \"WITH\", \"AS\", \"AT\", \"BY\", \"THIS\", \"BE\", \"OR\", \"AN\", \"HAVE\", \"FROM\", \"NOT\",\n",
        "    \"WE\", \"MY\", \"ME\", \"HELLO\", \"SECRET\", \"PASSWORD\", \"ATTACK\", \"MESSAGE\", \"KEY\",\n",
        "    \"COFFEE\", \"ADMIN\", \"HACK\", \"HACKER\", \"MEET\", \"AT\", \"NOON\", \"DAWN\", \"SERVER\",\n",
        "    \"ACCESS\", \"LOGIN\", \"DATA\", \"CODE\", \"FLAG\"\n",
        "}\n",
        "\n",
        "# Typical English letter frequencies (%), used as a tiebreaker\n",
        "ENGLISH_FREQ = {\n",
        "    'A': 8.17, 'B': 1.49, 'C': 2.78, 'D': 4.25, 'E': 12.70, 'F': 2.23, 'G': 2.02,\n",
        "    'H': 6.09, 'I': 6.97, 'J': 0.15, 'K': 0.77, 'L': 4.03, 'M': 2.41, 'N': 6.75,\n",
        "    'O': 7.51, 'P': 1.93, 'Q': 0.10, 'R': 5.99, 'S': 6.33, 'T': 9.06, 'U': 2.76,\n",
        "    'V': 0.98, 'W': 2.36, 'X': 0.15, 'Y': 1.97, 'Z': 0.07\n",
        "}\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 2: encryption algorithm\n",
        "# ----------------------------------------------------------\n",
        "def caesar_shift(text, shift):\n",
        "    \"\"\"Shift every letter by `shift` positions; keep case, spaces, punctuation.\"\"\"\n",
        "    out = []\n",
        "    for ch in text:\n",
        "        if ch.isalpha():\n",
        "            base = ord('A') if ch.isupper() else ord('a')\n",
        "            out.append(chr((ord(ch) - base + shift) % 26 + base))\n",
        "        else:\n",
        "            out.append(ch)\n",
        "    return \"\".join(out)\n",
        "\n",
        "\n",
        "def encrypt(plaintext, shift=3):\n",
        "    return caesar_shift(plaintext, shift)\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 3: decryption algorithm\n",
        "# ----------------------------------------------------------\n",
        "def decrypt(ciphertext, shift=3):\n",
        "    return caesar_shift(ciphertext, -shift)\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# BONUS: try all shifts 0-25\n",
        "# ----------------------------------------------------------\n",
        "def all_shifts(ciphertext):\n",
        "    return {s: decrypt(ciphertext, s) for s in range(26)}\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 5 helper: automatically pick the most likely plaintext\n",
        "# ----------------------------------------------------------\n",
        "def score_text(text):\n",
        "    \"\"\"Higher = more English-like. Word matches dominate; letter frequency breaks ties.\"\"\"\n",
        "    words = [w.strip(string.punctuation).upper() for w in text.split()]\n",
        "    word_hits = sum(1 for w in words if w in COMMON_WORDS)\n",
        "\n",
        "    letters = [c for c in text.upper() if c in ALPHABET]\n",
        "    if not letters:\n",
        "        return 0\n",
        "    counts = Counter(letters)\n",
        "    n = len(letters)\n",
        "    chi2 = sum(((counts.get(l, 0) - n * ENGLISH_FREQ[l] / 100) ** 2) / (n * ENGLISH_FREQ[l] / 100)\n",
        "               for l in ALPHABET)\n",
        "    return word_hits * 1000 - chi2     # lower chi-squared = closer to English\n",
        "\n",
        "\n",
        "def auto_decrypt(ciphertext):\n",
        "    candidates = all_shifts(ciphertext)\n",
        "    best_shift = max(candidates, key=lambda s: score_text(candidates[s]))\n",
        "    return best_shift, candidates[best_shift]\n",
