        "import re\n",
        "import ipaddress\n",
        "from datetime import datetime\n",
        "from collections import defaultdict\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# DATA: the fake login log from the challenge\n",
        "# ----------------------------------------------------------\n",
        "LOG_TEXT = \"\"\"\n",
        "10:01:12  admin     192.168.1.15  SUCCESS\n",
        "10:01:19  admin     192.168.1.15  SUCCESS\n",
        "10:02:01  admin     185.44.21.90  FAILED\n",
        "10:02:03  admin     185.44.21.90  FAILED\n",
        "10:02:05  admin     185.44.21.90  FAILED\n",
        "10:02:07  admin     185.44.21.90  FAILED\n",
        "10:02:09  admin     185.44.21.90  SUCCESS\n",
        "10:03:11  student   192.168.1.20  SUCCESS\n",
        "10:04:55  admin     185.44.21.90  SUCCESS\n",
        "\"\"\"\n",
        "\n",
        "# Detection settings\n",
        "FAIL_THRESHOLD = 3     # this many failures...\n",
        "WINDOW_SECONDS = 10    # ...inside this many seconds = brute force\n",
        "\n",
        "LINE_RE = re.compile(\n",
        "    r\"^(\\d{2}:\\d{2}:\\d{2})\\s+(\\S+)\\s+(\\d{1,3}(?:\\.\\d{1,3}){3})\\s+(SUCCESS|FAILED)$\"\n",
        ")\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 1: parse the logs\n",
        "# ----------------------------------------------------------\n",
        "def parse_logs(text):\n",
        "    events, bad_lines = [], []\n",
        "    for num, line in enumerate(text.strip().splitlines(), 1):\n",
        "        line = line.strip()\n",
        "        if not line:\n",
        "            continue\n",
        "        m = LINE_RE.match(line)\n",
        "        if not m:\n",
        "            bad_lines.append((num, line))\n",
        "            continue\n",
        "        t, user, ip, status = m.groups()\n",
        "        try:\n",
        "            ipaddress.ip_address(ip)  # validates each octet is 0-255\n",
        "            ts = datetime.strptime(t, \"%H:%M:%S\")\n",
        "        except ValueError:\n",
        "            bad_lines.append((num, line))\n",
        "            continue\n",
        "        events.append({\"time\": ts, \"time_str\": t, \"user\": user,\n",
        "                       \"ip\": ip, \"status\": status})\n",
        "    return events, bad_lines\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 3: detect brute-force behaviour\n",
        "# ----------------------------------------------------------\n",
        "def detect_bruteforce(events):\n",
        "    groups = defaultdict(list)\n",
        "    for e in events:\n",
        "        groups[(e[\"ip\"], e[\"user\"])].append(e)\n",
        "\n",
        "    findings = []\n",
        "    for (ip, user), evs in groups.items():\n",
        "        evs.sort(key=lambda e: e[\"time\"])\n",
        "        fails = [e for e in evs if e[\"status\"] == \"FAILED\"]\n",
        "\n",
        "        # sliding window: find the densest burst of failures\n",
        "        best = []\n",
        "        for i in range(len(fails)):\n",
        "            window = [f for f in fails[i:]\n",
        "                      if (f[\"time\"] - fails[i][\"time\"]).total_seconds() <= WINDOW_SECONDS]\n",
        "            if len(window) > len(best):\n",
        "                best = window\n",
        "\n",
        "        if len(best) < FAIL_THRESHOLD:\n",
        "            continue\n",
        "\n",
        "        last_fail = best[-1]\n",
        "        later_success = [e for e in evs\n",
        "                         if e[\"status\"] == \"SUCCESS\" and e[\"time\"] > last_fail[\"time\"]]\n",
        "        span = (best[-1][\"time\"] - best[0][\"time\"]).total_seconds()\n",
        "        gap = span / (len(best) - 1) if len(best) > 1 else 0\n",
        "\n",
        "        findings.append({\n",
        "            \"ip\": ip, \"user\": user,\n",
        "            \"fail_count\": len(best),\n",
        "            \"first_fail\": best[0][\"time_str\"],\n",
        "            \"last_fail\": last_fail[\"time_str\"],\n",
        "            \"avg_gap\": gap,\n",
        "            \"breach\": later_success[0] if later_success else None,\n",
        "            \"reuse\": later_success[1:],   # extra logins after the breach\n",
        "        })\n",
        "    return findings\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 2: detect suspicious IP addresses\n",
        "# ----------------------------------------------------------\n",
        "def detect_suspicious_ips(events, bf_findings):\n",
        "    reasons = defaultdict(list)\n",
        "    ips = {e[\"ip\"] for e in events}\n",
        "\n",
        "    for ip in ips:\n",
        "        if not ipaddress.ip_address(ip).is_private:\n",
        "            reasons[ip].append(\"External/public IP (not on the internal network)\")\n",
        "\n",
        "    for f in bf_findings:\n",
        "        reasons[f[\"ip\"]].append(\n",
        "            f\"{f['fail_count']} failed logins on '{f['user']}' in a short burst\")\n",
        "        if f[\"breach\"]:\n",
        "            reasons[f[\"ip\"]].append(\n",
        "                f\"Login SUCCEEDED right after failures (at {f['breach']['time_str']})\")\n",
        "        if f[\"reuse\"]:\n",
        "            reasons[f[\"ip\"]].append(\n",
        "                f\"Came back and logged in again at {f['reuse'][-1]['time_str']}\")\n",
        "\n",
        "    # simple risk score: internal-only anomalies stay low, brute force is high\n",
        "    result = {}\n",
        "    for ip, rs in reasons.items():\n",
        "        result[ip] = {\"reasons\": rs, \"risk\": \"HIGH\" if len(rs) >= 3 else\n",
        "                      \"MEDIUM\" if len(rs) == 2 else \"LOW\"}\n",
        "    return result\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 4: identify the likely compromised account\n",
        "# ----------------------------------------------------------\n",
        "def find_compromised(bf_findings):\n",
        "    breached = [f for f in bf_findings if f[\"breach\"]]\n",
        "    if breached:\n",
        "        # most failures first, then those with continued access\n",
        "        breached.sort(key=lambda f: (f[\"fail_count\"], len(f[\"reuse\"])), reverse=True)\n",
        "        return breached[0], \"CONFIRMED\"\n",
        "    if bf_findings:\n",
        "        return bf_findings[0], \"TARGETED (no successful login yet)\"\n",
        "    return None, \"NONE\"\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 5: generate the alert\n",
        "# ----------------------------------------------------------\n",
        "def build_alert(finding, status, ip_info):\n",
        "    if not finding:\n",
        "        return \"No brute-force activity detected.\"\n",
        "\n",
        "    f = finding\n",
        "    lines = [\n",
        "        \"=\" * 62,\n",
        "        \"ALERT: Possible Brute-Force Attack / Account Compromise\",\n",
        "        \"=\" * 62,\n",
        "        f\"Severity        : {'CRITICAL' if f['breach'] else 'HIGH'}\",\n",
        "        f\"Account         : {f['user']}\",\n",
        "        f\"Source IP       : {f['ip']}\",\n",
        "        f\"Failed attempts : {f['fail_count']} between {f['first_fail']} and {f['last_fail']}\"\n",
        "        f\" (about 1 every {f['avg_gap']:.0f}s)\",\n",
