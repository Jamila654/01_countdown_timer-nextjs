        "import os\n",
        "import hashlib\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# DATA: file list from the challenge (+ extra bonus test files)\n",
        "# ----------------------------------------------------------\n",
        "FILE_LIST = [\n",
        "    \"downloads/file1.pdf\",\n",
        "    \"downloads/report.docx\",\n",
        "    \"downloads/update.exe\",\n",
        "    \"downloads/photo.jpg\",\n",
        "    \"downloads/invoice.exe\",\n",
        "    \"downloads/presentation.pptx\",\n",
        "    \"downloads/setup.exe\",\n",
        "]\n",
        "\n",
        "# Extra files to demonstrate the BONUS (double-extension detection)\n",
        "BONUS_FILES = [\n",
        "    \"downloads/result.pdf.exe\",\n",
        "    \"downloads/photo.jpg.exe\",\n",
        "    \"downloads/invoice.docx.scr\",\n",
        "]\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# SETUP: create harmless placeholder files if they don't exist\n",
        "# ----------------------------------------------------------\n",
        "def create_demo_files(paths):\n",
        "    for p in paths:\n",
        "        os.makedirs(os.path.dirname(p), exist_ok=True)\n",
        "        if not os.path.exists(p):\n",
        "            with open(p, \"wb\") as f:\n",
        "                # harmless dummy content, unique per file name\n",
        "                f.write(f\"placeholder content for {os.path.basename(p)}\".encode())\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 1: dangerous extensions (with a base risk weight)\n",
        "# ----------------------------------------------------------\n",
        "EXTENSION_WEIGHTS = {\n",
        "    # executables / scripts: directly runnable -> highest danger\n",
        "    \".exe\": 70, \".scr\": 75, \".bat\": 70, \".cmd\": 70, \".com\": 70, \".pif\": 75,\n",
        "    \".msi\": 65, \".vbs\": 70, \".js\": 60, \".jar\": 60, \".ps1\": 65, \".dll\": 60,\n",
        "    # macro-enabled Office files\n",
        "    \".docm\": 50, \".xlsm\": 50, \".pptm\": 50,\n",
        "    # archives (can hide executables)\n",
        "    \".zip\": 30, \".rar\": 30, \".7z\": 30, \".iso\": 40,\n",
        "    # documents (can carry exploits/macros, but usually fine)\n",
        "    \".pdf\": 10, \".doc\": 15, \".docx\": 10, \".xls\": 15, \".xlsx\": 10,\n",
        "    \".ppt\": 15, \".pptx\": 10,\n",
        "    # media / plain files\n",
        "    \".jpg\": 0, \".jpeg\": 0, \".png\": 0, \".gif\": 0, \".txt\": 0, \".mp3\": 0, \".mp4\": 0,\n",
        "}\n",
        "DANGEROUS = {e for e, w in EXTENSION_WEIGHTS.items() if w >= 60}\n",
        "SAFE_LOOKING = {\".pdf\", \".doc\", \".docx\", \".xls\", \".xlsx\", \".ppt\", \".pptx\",\n",
        "                \".jpg\", \".jpeg\", \".png\", \".gif\", \".txt\", \".mp3\", \".mp4\"}\n",
        "SUSPICIOUS_WORDS = [\"update\", \"setup\", \"install\", \"invoice\", \"crack\", \"patch\",\n",
        "                    \"free\", \"urgent\", \"payment\", \"keygen\"]\n",
        "\n",
        "\n",
        "def get_extensions(filename):\n",
        "    \"\"\"Return every extension in the name, e.g. 'a.pdf.exe' -> ['.pdf', '.exe'].\"\"\"\n",
        "    parts = filename.lower().split(\".\")\n",
        "    return [\".\" + p for p in parts[1:]]\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 2: SHA-256 of each file\n",
        "# ----------------------------------------------------------\n",
        "def sha256_of(path):\n",
        "    h = hashlib.sha256()\n",
        "    try:\n",
        "        with open(path, \"rb\") as f:\n",
        "            for chunk in iter(lambda: f.read(8192), b\"\"):   # works for big files too\n",
        "                h.update(chunk)\n",
        "        return h.hexdigest()\n",
        "    except FileNotFoundError:\n",
        "        return \"FILE NOT FOUND\"\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 4: my own risk-classification algorithm (+ BONUS)\n",
        "# ----------------------------------------------------------\n",
        "def classify(filename):\n",
        "    \"\"\"Returns (risk_level, score, list_of_reasons).\"\"\"\n",
        "    exts = get_extensions(filename)\n",
        "    final_ext = exts[-1] if exts else \"\"\n",
        "    reasons = []\n",
        "\n",
        "    # Rule 1: base score from the final extension\n",
        "    score = EXTENSION_WEIGHTS.get(final_ext, 20 if final_ext else 25)\n",
        "    if final_ext in DANGEROUS:\n",
        "        reasons.append(f\"{final_ext} is an executable/script type\")\n",
        "    elif final_ext not in EXTENSION_WEIGHTS:\n",
        "        reasons.append(f\"unknown extension '{final_ext or 'none'}'\")\n",
        "\n",
        "    # Rule 2 (BONUS): double extension, e.g. result.pdf.exe\n",
        "    if len(exts) >= 2:\n",
        "        inner = exts[-2]\n",
        "        if inner in SAFE_LOOKING and final_ext in DANGEROUS:\n",
        "            score += 30\n",
        "            reasons.append(f\"DOUBLE EXTENSION: pretends to be '{inner}' but is really '{final_ext}'\")\n",
        "        elif len(exts) >= 2:\n",
        "            score += 10\n",
        "            reasons.append(\"multiple extensions in name\")\n",
        "\n",
        "    # Rule 3: social-engineering words in the name (only matter for risky types)\n",
        "    name_only = filename.lower()\n",
        "    hits = [w for w in SUSPICIOUS_WORDS if w in name_only]\n",
        "    if hits and final_ext in DANGEROUS:\n",
        "        score += 10\n",
        "        reasons.append(f\"lure word(s) in name: {', '.join(hits)}\")\n",
        "\n",
        "    score = min(score, 100)\n",
        "    if score >= 60:\n",
        "        level = \"HIGH\"\n",
        "    elif score >= 30:\n",
        "        level = \"MEDIUM\"\n",
        "    else:\n",
        "        level = \"LOW\"\n",
        "    if not reasons:\n",
        "        reasons.append(\"common, non-executable file type\")\n",
        "    return level, score, reasons\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# TASK 3: display results in a table\n",
        "# ----------------------------------------------------------\n",
        "def scan(paths):\n",
        "    rows = []\n",
        "    for p in paths:\n",
        "        name = os.path.basename(p)\n",
        "        exts = get_extensions(name)\n",
        "        level, score, reasons = classify(name)\n",
        "        rows.append({\n",
        "            \"name\": name,\n",
        "            \"ext\": exts[-1] if exts else \"(none)\",\n",
        "            \"sha\": sha256_of(p),\n",
        "            \"risk\": level,\n",
        "            \"score\": score,\n",
        "            \"reasons\": reasons,\n",
        "        })\n",
        "    return rows\n",
        "\n",
        "\n",
        "def print_table(rows):\n",
        "    cols = [\"Filename\", \"Extension\", \"SHA-256\", \"Risk\"]\n",
        "    data = [[r[\"name\"], r[\"ext\"], r[\"sha\"], r[\"risk\"]] for r in rows]\n",
        "    widths = [max(len(str(x)) for x in [c] + [d[i] for d in data]) for i, c in enumerate(cols)]\n",
        "    line = \"+-\" + \"-+-\".join(\"-\" * w for w in widths) + \"-+\"\n",
        "    print(line)\n",
        "    print(\"| \" + \" | \".join(c.ljust(w) for c, w in zip(cols, widths)) + \" |\")\n",
        "    print(line)\n",
        "    for d in data:\n",
        "        print(\"| \" + \" | \".join(str(x).ljust(w) for x, w in zip(d, widths)) + \" |\")\n",
        "    print(line)\n",
        "\n",
        "\n",
        "def print_explanations(rows):\n",
        "    print(\"\\nWhy each file got its rating:\")\n",
        "    for r in rows:\n",
        "        print(f\"  {r['name']:<22} {r['risk']:<7} (score {r['score']:>3}) -> {'; '.join(r['reasons'])}\")\n",
        "\n",
        "\n",
        "def main():\n",
        "    create_demo_files(FILE_LIST + BONUS_FILES)\n",
        "\n",
        "    print(\"=\" * 60)\n",
        "    print(\"MAIN SCAN: files from the challenge\")\n",
        "    print(\"=\" * 60)\n",
        "    rows = scan(FILE_LIST)\n",
        "    print_table(rows)\n",
        "    print_explanations(rows)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"BONUS: double-extension detection\")\n",
        "    print(\"=\" * 60)\n",
        "    bonus_rows = scan(BONUS_FILES)\n",
        "    print_table(bonus_rows)\n",
        "    print_explanations(bonus_rows)\n",
        "\n",
        "    high = [r[\"name\"] for r in rows + bonus_rows if r[\"risk\"] == \"HIGH\"]\n",
        "    print(f\"\\nSummary: {len(high)} HIGH-risk file(s): {', '.join(high)}\")\n",
        "\n",
        "\n",
        "main()"
      ],
