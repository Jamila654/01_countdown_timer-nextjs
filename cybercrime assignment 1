        "import re\n",
        "from collections import defaultdict, Counter\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# DATA: the log from the challenge\n",
        "# ----------------------------------------------------------\n",
        "LOG_TEXT = \"\"\"\n",
        "08:10 USER_LOGIN alice SUCCESS\n",
        "08:11 FILE_ACCESS alice marks.xlsx\n",
        "08:12 FILE_ACCESS alice salary.xlsx\n",
        "08:13 FILE_ACCESS alice passwords.txt\n",
        "08:14 FILE_ACCESS alice database_backup.sql\n",
        "08:15 DOWNLOAD alice database_backup.sql\n",
        "08:16 USER_LOGIN admin FAILED\n",
        "08:17 USER_LOGIN admin FAILED\n",
        "08:18 USER_LOGIN admin FAILED\n",
        "08:19 USER_LOGIN admin SUCCESS\n",
        "08:20 DOWNLOAD admin student_records.csv\n",
        "\"\"\"\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# SETTINGS (change these to tune the detector)\n",
        "# ----------------------------------------------------------\n",
        "# (keyword in filename, risk points, display label; None = use the filename)\n",
        "SENSITIVE_RULES = [\n",
        "    (\"password\",        25, None),\n",
        "    (\"backup\",          20, \"database backup\"),\n",
        "    (\".sql\",            20, \"database backup\"),\n",
        "    (\"salary\",          12, None),\n",
        "    (\"student_records\", 15, None),\n",
        "    (\"records\",         15, None),\n",
        "    (\"marks\",            8, None),\n",
        "    (\"grade\",            8, None),\n",
        "]\n",
        "FAIL_THRESHOLD   = 3    # consecutive failed logins that count as brute force\n",
        "PTS_FAILED_LOGINS = 25\n",
        "PTS_SUCCESS_AFTER_FAIL = 20\n",
        "PTS_BULK_ACCESS  = 7    # 3+ different sensitive files in a short time\n",
        "BULK_FILES, BULK_WINDOW_MIN = 3, 10\n",
        "PTS_TAKEOVER_CHAIN = 15 # failed logins -> success -> sensitive download\n",
        "MIN_DOWNLOAD_PTS = 10\n",
        "SEVERITY = [(85, \"CRITICAL\"), (65, \"HIGH\"), (40, \"MEDIUM\"), (1, \"LOW\"), (0, \"NONE\")]\n",
        "\n",
        "LINE_RE = re.compile(r\"^(\\d{2}):(\\d{2})\\s+(USER_LOGIN|FILE_ACCESS|DOWNLOAD)\\s+(\\S+)\\s+(\\S+)$\")\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# PARSE THE LOG\n",
        "# ----------------------------------------------------------\n",
        "def parse_log(text):\n",
        "    events, bad = [], []\n",
        "    for line in text.strip().splitlines():\n",
        "        line = line.strip()\n",
        "        if not line:\n",
        "            continue\n",
        "        m = LINE_RE.match(line)\n",
        "        if not m:\n",
        "            bad.append(line)\n",
        "            continue\n",
        "        hh, mm, kind, user, detail = m.groups()\n",
        "        events.append({\"clock\": f\"{hh}:{mm}\", \"min\": int(hh) * 60 + int(mm),\n",
        "                       \"type\": kind, \"user\": user, \"detail\": detail})\n",
        "    return events, bad\n",
        "\n",
        "\n",
        "# ----------------------------------------------------------\n",
        "# DETECTION HELPERS\n",
        "# ----------------------------------------------------------\n",
        "def sensitivity(filename):\n",
        "    \"\"\"Detect sensitive-file access: returns (points, label) or None.\"\"\"\n",
        "    f = filename.lower()\n",
        "    for keyword, pts, label in SENSITIVE_RULES:\n",
        "        if keyword in f:\n",
        "            return pts, (label or filename)\n",
        "    return None\n",
        "\n",
        "\n",
        "def severity_of(score):\n",
        "    for limit, name in SEVERITY:\n",
        "        if score >= limit:\n",
        "            return name\n",
        "\n",
        "\n",
        "def analyze_user(user, evs):\n",
        "    evs = sorted(evs, key=lambda e: e[\"min\"])\n",
        "    score, reasons = 0, []\n",
        "\n",
        "    # 1) sensitive-file access\n",
        "    accessed = []\n",
        "    for e in evs:\n",
        "        if e[\"type\"] == \"FILE_ACCESS\":\n",
        "            s = sensitivity(e[\"detail\"])\n",
        "            if s:\n",
        "                score += s[0]\n",
        "                reasons.append(f\"Accessed {s[1]}\")\n",
        "                accessed.append(e)\n",
        "    distinct = {e[\"detail\"] for e in accessed}\n",
        "    if len(distinct) >= BULK_FILES:\n",
        "        span = accessed[-1][\"min\"] - accessed[0][\"min\"]\n",
        "        if span <= BULK_WINDOW_MIN:\n",
        "            score += PTS_BULK_ACCESS\n",
        "            reasons.append(f\"Bulk access: {len(distinct)} sensitive files in {span} min\")\n",
        "\n",
        "    # 2) multiple failed logins (+ success right after)\n",
        "    run, best_run, success_after = [], [], None\n",
        "    for e in evs:\n",
        "        if e[\"type\"] != \"USER_LOGIN\":\n",
        "            continue\n",
        "        if e[\"detail\"] == \"FAILED\":\n",
        "            run.append(e)\n",
        "        else:\n",
        "            if len(run) >= FAIL_THRESHOLD and len(run) > len(best_run):\n",
        "                best_run, success_after = run, e\n",
        "            run = []\n",
        "    if len(run) >= FAIL_THRESHOLD and len(run) > len(best_run):\n",
        "        best_run, success_after = run, None\n",
        "    if len(best_run) >= FAIL_THRESHOLD:\n",
        "        score += PTS_FAILED_LOGINS\n",
        "        reasons.append(f\"{len(best_run)} failed logins in a row \"\n",
        "                       f\"({best_run[0]['clock']}-{best_run[-1]['clock']})\")\n",
        "        if success_after:\n",
        "            score += PTS_SUCCESS_AFTER_FAIL\n",
        "            reasons.append(f\"Login succeeded after failures at {success_after['clock']} \"\n",
        "                           \"(possible brute-force success)\")\n",
        "\n",
        "    # 3) suspicious downloads\n",
        "    takeover = False\n",
        "    for e in evs:\n",
        "        if e[\"type\"] == \"DOWNLOAD\":\n",
        "            s = sensitivity(e[\"detail\"])\n",
        "            if s:\n",
        "                score += max(MIN_DOWNLOAD_PTS, s[0])\n",
        "                reasons.append(f\"Downloaded {s[1]}\")\n",
        "                if success_after and e[\"min\"] >= success_after[\"min\"]:\n",
        "                    takeover = True\n",
        "    if takeover:\n",
        "        score += PTS_TAKEOVER_CHAIN\n",
        "        reasons.append(\"Account takeover pattern: failed logins -> success -> sensitive download\")\n",
        "\n",
        "    score = min(score, 100)\n",
        "    return {\"user\": user, \"score\": score, \"severity\": severity_of(score), \"reasons\": reasons}\n",
        "\n",
        "\n",
        "def analyze(events):\n",
        "    by_user = defaultdict(list)\n",
        "    for e in events:\n",
        "        by_user[e[\"user\"]].append(e)\n",
        "    results = [analyze_user(u, evs) for u, evs in by_user.items()]\n",
